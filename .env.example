# Research-Daten — OpenBB-Provider (nur was du wirklich nutzt)
# Default: yfinance (kein Key). Tiingo wird automatisch gewählt, sobald TIINGO_TOKEN gesetzt ist.
# Override via QUANTRACE_DATA_PROVIDER=tiingo|fmp|polygon|...
QUANTRACE_DATA_PROVIDER=
TIINGO_TOKEN=
FMP_API_KEY=
POLYGON_API_KEY=
INTRINIO_API_KEY=
ALPHA_VANTAGE_API_KEY=

# News-Layer (#166) — Research-Kontext für die Hypothesen-Generierung,
# ausdrücklich KEIN Backtest-Feature. Default `off`: ohne Opt-in entstehen
# keine Notes und der Research-Prompt ändert sich nicht.
#   off           — aus (Default)
#   gdelt         — keyless
#   alpha_vantage — braucht ALPHA_VANTAGE_API_KEY (25 Requests/Tag im Free-Tier)
NEWS_PROVIDER=off

# Phase 2 — Alpaca (Paper Trading + Live-Daten, kostenlos, kein Broker-Account nötig)
# Erstelle Account auf https://app.alpaca.markets, "Paper Trading" Keys generieren.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Daten-See (Parquet-Storage). Unset → lokal (data/processed). Gesetzt → Cloudflare R2 / S3.
# Bulk-Kursdaten gehören NICHT in Postgres und nicht auf den ephemeren Container-Disk.
# R2-Bucket anlegen, S3-API-Token generieren, dann:
QUANTRACE_DATA_LAKE=                                  # z.B. s3://quantrace-data/processed
R2_ENDPOINT_URL=                                      # https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=                                    # R2 Access Key ID
AWS_SECRET_ACCESS_KEY=                                # R2 Secret Access Key

# Obsidian Local REST API
OBSIDIAN_API_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=
OBSIDIAN_VAULT_PATH=

# IBKR (paper account first — port 7497 paper, 7496 live)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
IBKR_ACCOUNT=

# Research-Agent — Azure AI Foundry (primary)
# Foundry-Format:  https://<hub>.services.ai.azure.com/api/projects/<project>/openai/v1
# Classic-Format:  https://<resource>.openai.azure.com
# Beide werden automatisch erkannt.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Research-Agent — Anthropic (alternative, optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

# Vault git-Writes (Prod). VAULT_WRITE_MODE=local überspringt commit/push (Dev).
# GITHUB_TOKEN: fine-grained PAT (Contents: read & write) für den Push.
# VAULT_GIT_NAME/EMAIL: Committer-Identität. Die EMAIL MUSS einem echten
# GitHub-Account entsprechen, sonst blocken Deploy-Gates (z.B. Vercel) den Push.
# Nimm deine GitHub-Noreply aus Settings → Emails — Form:
#   <id>+<login>@users.noreply.github.com   (z.B. 12345678+your-github-login@users.noreply.github.com)
VAULT_WRITE_MODE=
GITHUB_TOKEN=
VAULT_GIT_NAME=
VAULT_GIT_EMAIL=

# --- Datenbank ---------------------------------------------------------------
# Postgres für Pipeline-Runs, Audit-Log, Instrument-Master und Watchlists.
# Beliebiger Anbieter (Render, Neon, Supabase, selbst gehostet) — das Schema in
# db/migrations/ ist portabel. Leer lassen = die betroffenen Endpoints antworten
# ehrlich (503 mit Migrations-Hinweis) statt still zu no-oppen.
# Für lokale Skripte die EXTERNE URL nehmen; interne Hostnamen (z.B. Renders
# *-internal) sind nur innerhalb des jeweiligen Netzes auflösbar.
DATABASE_URL=

# Runtime
QUANTRACE_ENV=dev
