# Research-Daten — OpenBB-Provider (nur was du wirklich nutzt)
# Default: eodhd (US-Bulk aus dem eigenen Lake, survivorship-frei).
# Andere Werte gehen über OpenBB und sind für Backtests nicht vorgesehen.
# Override via QUANTRACE_DATA_PROVIDER=eodhd|fmp|polygon|...
QUANTRACE_DATA_PROVIDER=eodhd
FMP_API_KEY=
POLYGON_API_KEY=
INTRINIO_API_KEY=
ALPHA_VANTAGE_API_KEY=

# EODHD — voller US-Markt als Tagesquerschnitt (Kurse + Splits + Dividenden).
# Token im EODHD-Dashboard unter "API token". EOD-Tarif genügt.
# Loader: EODHD_API_KEY=… python scripts/load_us_equities.py --status
EODHD_API_KEY=

# FRED — Makro für Regime (opt-in, default aus). Kostenlos:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SEC EDGAR — Fundamentals (point-in-time via filed). Kein Key, aber
# User-Agent mit Kontakt ist Pflicht (sonst IP-Sperre). Form: "Name email@…"
SEC_USER_AGENT=

# News-Layer (#166) — Research-Kontext für die Hypothesen-Generierung,
# ausdrücklich KEIN Backtest-Feature. Default `off`: ohne Opt-in entstehen
# keine Notes und der Research-Prompt ändert sich nicht.
#   off           — aus (Default)
#   gdelt         — keyless
#   alpha_vantage — braucht ALPHA_VANTAGE_API_KEY (25 Requests/Tag im Free-Tier)
NEWS_PROVIDER=off

# Phase 2 — Alpaca (Paper Trading + Live-Daten, kostenlos, kein Broker-Account nötig)
# Erstelle Account auf https://app.alpaca.markets, "Paper Trading" Keys generieren.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Daten-See (Parquet-Storage). Unset → lokal (data/processed). Gesetzt → Cloudflare R2 / S3.
# Bulk-Kursdaten gehören NICHT in Postgres und nicht auf den ephemeren Container-Disk.
# R2-Bucket anlegen, S3-API-Token generieren, dann:
#   R2_ENDPOINT_URL = Account-Host OHNE Bucket-Pfad (kein trailing /bucket) —
#   sonst brechen LIST-Aufrufe (Coverage), während GET/PUT noch greifen.
QUANTRACE_DATA_LAKE=                                  # z.B. s3://qlab/processed

# Wohin DuckDB seinen Sortier-Zwischenstapel legt. Leer = Standard, also `.tmp`
# im Arbeitsverzeichnis — und damit auf der Platte, auf der das Repo liegt,
# unabhängig davon, wo tatsächlich Platz ist. `build_resolved.py --all` sortiert
# ~88 Mio. Zeilen extern und braucht dafür mehrere GB; scheitert das, meldet
# DuckDB `No space left on device` ohne zu sagen, welche Platte gemeint ist.
QUANTRACE_DUCKDB_TEMP_DIR=                            # z.B. /mnt/hdd/quantrace-tmp

# Wie lang ein Fenster sein darf, für das Splits/Dividenden noch gelesen werden.
# Leer = 3000 Tage. Die Grenze schützt einen HTTP-Request vor Herokus
# 30s-Router-Timeout (ein GET je Tagespartition, zwei Feeds) — außerhalb eines
# Requests schützt sie nichts und kostet die Adjustierung: ein Backtest über
# 15 Jahre bekommt rohe Kurse und bricht zu Recht ab. Für lokale Läufe deshalb
# `0` (keine Grenze); auf der API bleibt der Default richtig.
QUANTRACE_MAX_ADJUST_WINDOW_DAYS=                     # z.B. 0 für lokale Backtests
R2_ENDPOINT_URL=                                      # https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=                                    # R2 Access Key ID
AWS_SECRET_ACCESS_KEY=                                # R2 Secret Access Key

# Obsidian Local REST API
OBSIDIAN_API_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=
OBSIDIAN_VAULT_PATH=

# IBKR (paper account first — port 7497 paper, 7496 live)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
IBKR_ACCOUNT=

# Research-Agent — Azure AI Foundry (primary)
# Foundry-Format:  https://<hub>.services.ai.azure.com/api/projects/<project>/openai/v1
# Classic-Format:  https://<resource>.openai.azure.com
# Beide werden automatisch erkannt.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Research-Agent — Anthropic (alternative, optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

# Vault git-Writes (Prod). VAULT_WRITE_MODE=local überspringt commit/push (Dev).
# GITHUB_TOKEN: fine-grained PAT (Contents: read & write) für den Push.
# VAULT_GIT_NAME/EMAIL: Committer-Identität. Die EMAIL MUSS einem echten
# GitHub-Account entsprechen, sonst blocken Deploy-Gates (z.B. Vercel) den Push.
# Nimm deine GitHub-Noreply aus Settings → Emails — Form:
#   <id>+<login>@users.noreply.github.com   (z.B. 12345678+your-github-login@users.noreply.github.com)
VAULT_WRITE_MODE=
GITHUB_TOKEN=
VAULT_GIT_NAME=
VAULT_GIT_EMAIL=

# Lokale Pipeline-Runs (`quantrace run-local`, der Knopf „Lokal rechnen").
# Trotz des Namens stellt QuantRace diesen Token NICHT aus: die API reicht ihn
# an `https://api.github.com/user` weiter und schlägt den zurückgemeldeten
# Login in `config/users.yaml` nach. Es ist also ein GitHub-Token mit
# `read:user` — `gh auth token` gibt einen aus, wenn die GitHub CLI schon
# eingerichtet ist; ein eigener PAT (Settings → Developer settings) trägt
# weniger Rechte als der der CLI.
QUANTRACE_API_TOKEN=

# --- Datenbank ---------------------------------------------------------------
# Postgres für Pipeline-Runs, Audit-Log, Instrument-Master und Watchlists.
# Beliebiger Anbieter (Render, Neon, Supabase, selbst gehostet) — das Schema in
# db/migrations/ ist portabel. Leer lassen = die betroffenen Endpoints antworten
# ehrlich (503 mit Migrations-Hinweis) statt still zu no-oppen.
# Für lokale Skripte die EXTERNE URL nehmen; interne Hostnamen (z.B. Renders
# *-internal) sind nur innerhalb des jeweiligen Netzes auflösbar.
#
# ⚠ IN ANFÜHRUNGSZEICHEN. Neon hängt `&channel_binding=require` an, und ein
# unquotetes `&` ist für die Shell ein Job-Trenner: `set -a; source .env`
# schickt die halbe Zeile in den Hintergrund, `DATABASE_URL` landet nie in der
# Umgebung — und der Job-Log druckt die vollständige URL **samt Passwort** auf
# das Terminal. Am 2026-08-13 genau so passiert. Dasselbe gilt für jeden Wert
# mit `&`, `#`, `;` oder Leerzeichen.
DATABASE_URL=""

# Runtime
QUANTRACE_ENV=dev
