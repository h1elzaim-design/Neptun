# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Envs
.venv/
venv/
env/
.env
.env.local
# `env/` oben passt nur auf Verzeichnisse. Eine *Datei* namens `env` — wie sie
# ein `docker run --env-file env` hinterlässt — war damit nicht erfasst und
# stand als untracked im Baum: ein `git add -A` hätte Klartext-Zugangsdaten
# committet. Genau so lag `quantrace/env` hier (nie committet, aber ungeschützt).
env
**/env
.env.*
!.env.example

# Notebooks
.ipynb_checkpoints/

# Databases — never commit dumps or local DB files
*.db
*.sqlite
*.sqlite3
*.sql
# ...aber Schema-Migrationen sind Quellcode, kein Dump. Ohne diese Ausnahme
# verschluckt `*.sql` jede neue Datei unter db/migrations/ still — genau so
# fehlen die Migrationen für `instruments` (#176) und `watchlists` (#178) im
# Repo, obwohl der Code sie namentlich referenziert.
!db/migrations/*.sql

# Editor temp/backup files
*~
.*.swp
.*.swo
*.bak

# IDE
.vscode/
.idea/

# Data — never commit market data or generated artifacts
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# `backtests/results/` trägt die Single-Run-JSONs — und die sind **Quelle**,
# nicht Abfall. Die Vault-Note verweist per `source_json` darauf; `/interpret`
# und jede Neubewertung lesen sie zurück. `sweeps/` und `walkforward/` waren
# nie ignoriert und werden seit jeher mitcommittet.
#
# Die pauschale Regel hat am 2026-08-11 jeden Single-Backtest am Publish
# scheitern lassen (`git add … failed: paths are ignored`), während Sweep und
# Walk-Forward durchliefen — ein Modus kaputt, zwei heil, und niemand sah den
# Zusammenhang. Zweite Auflage desselben Fehlers wie das pauschale `*.sql`,
# das zwei Migrationen nie ins Repo ließ.
backtests/results/*
!backtests/results/.gitkeep
!backtests/results/*.json
reports/*
!reports/.gitkeep
strategies/generated/*
!strategies/generated/.gitkeep

# OS
.DS_Store
Thumbs.db

# Obsidian — plugin state that carries secrets must never be tracked:
# obsidian-local-rest-api's data.json holds the REST API key + a TLS private key.
.obsidian/plugins/*/data.json
# workspace.json ist reiner Maschinen-UI-Zustand (offene Tabs, Pane-Layout).
# Obsidian schreibt sie bei jedem Öffnen neu; getrackt erzeugt sie nur Diff-Rauschen
# und veraltete Verweise auf längst gelöschte Notes.
.obsidian/workspace.json

# Messeingang des Regime-Prüfstands (#231) — Tagesdaten aus einer freien
# Schnittstelle, ausdrücklich keine Produktdatenquelle. Siehe
# scripts/regime_model_selection.py.
.cache/
